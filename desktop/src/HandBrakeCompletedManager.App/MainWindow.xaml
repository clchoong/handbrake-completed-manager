<Window x:Class="HandBrakeCompletedManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HandBrakeCompletedManager.App"
        xmlns:core="clr-namespace:HandBrakeCompletedManager.Core;assembly=HandBrakeCompletedManager.Core"
        Title="HandBrake Completed Manager"
        Height="900"
        Width="1400"
        MinHeight="700"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:OneBasedIndexConverter x:Key="OneBasedIndexConverter" />
        <local:OutputPercentageHighlightConverter x:Key="OutputPercentageHighlightConverter" />
        <Style x:Key="NumberCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OutputPercentageCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Record.OutputPercentage, Converter={StaticResource OutputPercentageHighlightConverter}}"
                             Value="{x:Static core:OutputPercentageHighlight.Orange}">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Record.OutputPercentage, Converter={StaticResource OutputPercentageHighlightConverter}}"
                             Value="{x:Static core:OutputPercentageHighlight.Red}">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SourceMissingOnRefresh}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#F3F4F6" />
                    <Setter Property="Foreground" Value="#657080" />
                    <Setter Property="ToolTip" Value="Source not found during refresh. The file may be missing or its drive unavailable." />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="28,20" Background="{StaticResource NavyBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="46"
                       Height="46"
                       Margin="0,0,14,0"
                       Source="Assets/HandBrakeCompletedManager.png"
                       Stretch="Uniform" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="HandBrake Completed Manager" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="#AEB9CA"
                               Text="Permanent source-to-output history after HandBrake finishes" />
                </StackPanel>
                <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="SetupButton" MinWidth="90" Margin="0,0,8,0" Background="#263650" BorderBrush="#3A4A63" Foreground="White" Content="Setup" Click="SetupButton_Click" ToolTip="HandBrake connection and completion capture setup" />
                    <Button x:Name="ArchiveButton" MinWidth="90" Margin="0,0,8,0" Background="#263650" BorderBrush="#3A4A63" Foreground="White" Content="History file" Click="ArchiveButton_Click" />
                    <Button x:Name="ImportLogsButton"
                            MinWidth="108"
                            Margin="0,0,8,0"
                            Background="#263650"
                            BorderBrush="#3A4A63"
                            Foreground="White"
                            Click="ImportLogsButton_Click"
                            Content="Import logs" />
                    <Button x:Name="RecoveryButton"
                            MinWidth="120"
                            Margin="0,0,8,0"
                            Background="#263650"
                            BorderBrush="#3A4A63"
                            Foreground="White"
                            Click="RecoveryButton_Click"
                            Content="Recovery (0)"
                            IsEnabled="False" />
                    <Button x:Name="SettingsButton"
                            MinWidth="96"
                            Margin="0,0,8,0"
                            Background="#263650"
                            BorderBrush="#3A4A63"
                            Foreground="White"
                            Click="SettingsButton_Click"
                            Content="Settings" />
                    <Button x:Name="AboutButton"
                            MinWidth="84"
                            Margin="0,0,8,0"
                            Background="#263650"
                            BorderBrush="#3A4A63"
                            Foreground="White"
                            Click="AboutButton_Click"
                            Content="About" />
                    <Button x:Name="RefreshButton"
                            MinWidth="96"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="RefreshButton_Click"
                            Content="Refresh" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,20,28,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="3" />
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <TextBlock Style="{StaticResource EyebrowStyle}" Text="COMPLETED ENCODES" />
                                <TextBlock x:Name="CompletedCountText"
                                           Margin="0,5,0,0"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Text="0" />
                                <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" Text="Captured permanently" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="8,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#6172D9" CornerRadius="3" />
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <TextBlock Style="{StaticResource EyebrowStyle}" Text="ORIGINAL LIBRARY" />
                                <TextBlock x:Name="OriginalSizeText" Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold" Text="0 B" />
                                <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" Text="Before conversion" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Margin="8,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#2898A8" CornerRadius="3" />
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <TextBlock Style="{StaticResource EyebrowStyle}" Text="CONVERTED LIBRARY" />
                                <TextBlock x:Name="ConvertedSizeText" Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold" Text="0 B" />
                                <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" Text="After conversion" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SuccessBrush}" CornerRadius="3" />
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <TextBlock Style="{StaticResource EyebrowStyle}" Text="STORAGE SAVED" />
                                <TextBlock x:Name="SpaceSavedText" Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold" Text="0 B" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource SuccessBrush}" Text="Recovered capacity" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="SetupPanel" Grid.Row="1" Grid.RowSpan="2" Margin="0,0,0,16" Padding="14" Background="#F8F9FC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
                  <StackPanel>
                    <DockPanel Margin="4,0,4,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource CompactButtonStyle}" Content="Close" Click="CloseSetupButton_Click" />
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16" Text="HandBrake setup" />
                    </DockPanel>
                <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Margin="0,0,14,0" Background="{StaticResource SuccessSoftBrush}" CornerRadius="10">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Text="&#xE968;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="HandBrake installation" />
                            <TextBlock x:Name="ConnectionStatusText" Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" Text="Not checked" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                            <ComboBox x:Name="InstallationComboBox"
                                      AutomationProperties.Name="Detected HandBrake installation"
                                      Width="360"
                                      Margin="0,0,10,0"
                                      ItemsSource="{Binding DetectedInstallations}"
                                      DisplayMemberPath="DisplayLabel"
                                      SelectionChanged="InstallationComboBox_SelectionChanged" />
                            <Button x:Name="FindHandBrakeButton"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="FindHandBrakeButton_Click"
                                    Content="Find HandBrake" />
                            <Button x:Name="BrowseHandBrakeButton"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="BrowseHandBrakeButton_Click"
                                    Content="Browse" />
                            <Button x:Name="TestConnectionButton"
                                    Style="{StaticResource SoftAccentButtonStyle}"
                                    Click="TestConnectionButton_Click"
                                    Content="Test app storage"
                                    ToolTip="Tests simulated history storage only. Does not check HandBrake preferences or run an encode."
                                    IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander IsExpanded="False">
                    <Expander.Header>
                        <Border Padding="18,14" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Completion capture setup" />
                                    <TextBlock x:Name="ReceiverStatusText" Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" Text="Checking receiver..." />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           Text="Show setup" />
                            </Grid>
                        </Border>
                    </Expander.Header>
                    <Border Margin="0,8,0,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="95" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="3"
                                       Margin="0,0,0,14"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="1. In HandBrake, open Tools > Preferences > When Done.&#x0a;2. Under Encode Completed, check Send file to. Click Browse and select the receiver executable below (not the Manager app).&#x0a;3. Copy the arguments below into HandBrake’s Arguments box. Return from Preferences." />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Executable" />
                            <TextBox x:Name="ReceiverPathTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,10,8" IsReadOnly="True" />
                            <Button Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" Style="{StaticResource CompactButtonStyle}" Click="CopyReceiverPathButton_Click" Content="Copy path" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Arguments" />
                            <TextBox x:Name="ReceiverArgumentsTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,10,0" IsReadOnly="True" />
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource CompactButtonStyle}" Click="CopyReceiverArgumentsButton_Click" Content="Copy args" />
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"
                                       Text="4. Run a short new encode in HandBrake. Open the Manager and click Refresh. Seeing that encode in Completed library confirms automatic capture. For older jobs, use Import logs.&#x0a;The app storage test is only a simulation; it does not verify the HandBrake setting or the receiver." />
                        </Grid>
                    </Border>
                </Expander>
                  </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="20,18,20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Completed library" />
                                <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" Text="Search, inspect, and safely manage completed encodes" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBox x:Name="HistorySearchTextBox"
                                         AutomationProperties.Name="Search completed history"
                                         Width="260"
                                         Margin="0,0,8,0"
                                         ToolTip="Search filenames, paths, extensions, and statuses"
                                         TextChanged="HistorySearchTextBox_TextChanged" />
                                <ComboBox x:Name="QuickFilterComboBox"
                                          AutomationProperties.Name="Completed history quick filter"
                                          Width="190"
                                          Margin="0,0,8,0"
                                          SelectionChanged="QuickFilterComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="All" Content="All records" />
                                    <ComboBoxItem Tag="Today" Content="Today" />
                                    <ComboBoxItem Tag="LastSevenDays" Content="Last 7 days" />
                                    <ComboBoxItem Tag="MissingFiles" Content="Missing files" />
                                    <ComboBoxItem Tag="OutputLargerThanSource" Content="Output larger than source" />
                                </ComboBox>
                                <Button Style="{StaticResource CompactButtonStyle}" Click="ClearHistoryFiltersButton_Click" Content="Clear" />
                                <Button x:Name="SelectAllShownButton"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Click="SelectAllShownButton_Click"
                                        Content="Select all shown" />
                                <Button x:Name="ClearSelectionButton"
                                        Margin="6,0,0,0"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Click="ClearSelectionButton_Click"
                                        Content="Clear selection"
                                        IsEnabled="False" />
                                <TextBlock x:Name="ResultsCountText"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           Text="0 shown" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Padding="16,12"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,1,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectedRecordText"
                                           Margin="4,0,16,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           Text="Select a completed encode" />
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <Button x:Name="ReviewReplacementButton"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="ReplaceSourceButton_Click"
                                            Content="Replace source"
                                            IsEnabled="False" />
                                    <Button x:Name="PlayDestinationButton" Margin="0,0,6,0" Style="{StaticResource CompactButtonStyle}" Click="PlayDestinationButton_Click" Content="Play output" IsEnabled="False" />
                                    <Button x:Name="PlaySourceButton" Margin="0,0,6,0" Style="{StaticResource CompactButtonStyle}" Click="PlaySourceButton_Click" Content="Play source" IsEnabled="False" />
                                    <Button x:Name="RevealDestinationButton" Margin="0,0,6,0" Style="{StaticResource CompactButtonStyle}" Click="RevealDestinationButton_Click" Content="Show output" IsEnabled="False" />
                                    <Button x:Name="RevealSourceButton" Margin="0,0,6,0" Style="{StaticResource CompactButtonStyle}" Click="RevealSourceButton_Click" Content="Show source" IsEnabled="False" />
                                    <Button x:Name="RecycleOutputButton" Margin="0,0,6,0" Style="{StaticResource DangerButtonStyle}" Click="RecycleOutputButton_Click" Content="Recycle output" IsEnabled="False" />
                                    <Button x:Name="RemoveHistoryButton" Margin="0,0,6,0" Style="{StaticResource CompactButtonStyle}" Click="RemoveHistoryButton_Click" Content="Remove history" IsEnabled="False" />
                                    <Button x:Name="StopBulkButton"
                                            Style="{StaticResource SoftAccentButtonStyle}"
                                            Click="StopBulkButton_Click"
                                            Content="Stop after current"
                                            Visibility="Collapsed" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="HistoryGrid"
                                  Grid.Row="2"
                                  ItemsSource="{Binding HistoryRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  AlternationCount="1"
                                  RowStyle="{StaticResource HistoryRowStyle}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  SelectionChanged="HistoryGrid_SelectionChanged"
                                  PreviewMouseRightButtonDown="HistoryGrid_PreviewMouseRightButtonDown"
                                  ContextMenuOpening="HistoryGrid_ContextMenuOpening"
                                  PreviewKeyDown="HistoryGrid_PreviewKeyDown"
                                  PreviewMouseWheel="HistoryGrid_PreviewMouseWheel"
                                  MouseDoubleClick="HistoryGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu x:Name="HistoryContextMenu">
                                    <MenuItem x:Name="ContextReplace" Click="ReplaceSourceButton_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ContextPlayOutput" Header="Play output" Click="PlayDestinationButton_Click" />
                                    <MenuItem x:Name="ContextPlaySource" Header="Play source" Click="PlaySourceButton_Click" />
                                    <MenuItem x:Name="ContextShowOutput" Header="Show output" Click="RevealDestinationButton_Click" />
                                    <MenuItem x:Name="ContextShowSource" Header="Show source" Click="RevealSourceButton_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ContextRecycle" Click="RecycleOutputButton_Click" />
                                    <MenuItem x:Name="ContextRemove" Click="RemoveHistoryButton_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="#" Width="56" CanUserSort="False" CellStyle="{StaticResource NumberCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}}"
                                                       Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=AlternationIndex, Converter={StaticResource OneBasedIndexConverter}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="COMPLETED" Binding="{Binding Completed}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" SortMemberPath="Record.CompletedAtUtc" Width="150" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" SortMemberPath="Status" Width="205" />
                                <DataGridTextColumn Header="SOURCE" Binding="{Binding SourceFilename}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" SortMemberPath="Record.SourceFilename" Width="*" MinWidth="170" />
                                <DataGridTextColumn Header="ORIGINAL" Binding="{Binding SourceSize}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" SortMemberPath="Record.SourceSize" Width="110" />
                                <DataGridTextColumn Header="CONVERTED" Binding="{Binding DestinationSize}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" SortMemberPath="Record.DestinationSize" Width="115" />
                                <DataGridTextColumn Header="OUTPUT SIZE" Binding="{Binding OutputPercentage}" CellStyle="{StaticResource OutputPercentageCellStyle}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" SortMemberPath="Record.OutputPercentage" Width="105" />
                                <DataGridTextColumn Header="SAVED" Binding="{Binding SpaceSaved}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" SortMemberPath="Record.SpaceSavedBytes" Width="110" />
                                <DataGridTextColumn Header="CONVERTED FILE" Binding="{Binding DestinationFilename}" ElementStyle="{StaticResource CenteredDataGridTextStyle}" SortMemberPath="Record.DestinationFilename" Width="*" MinWidth="170" />
                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>
                </Border>
        </Grid>

        <Border Grid.Row="2" Margin="28,0,28,10" Padding="16,10" Background="#F8F9FC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
            <DockPanel LastChildFill="True">
                <ToggleButton x:Name="DetailsToggle" DockPanel.Dock="Right" Width="30" Height="30" Margin="12,0,0,0" FontFamily="Segoe MDL2 Assets" Content="&#xE70D;" ToolTip="Expand details" AutomationProperties.Name="Expand record details" Click="DetailsToggle_Click">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ArrowBorder" CornerRadius="15" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="White">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowBorder" Property="Background" Value="#E9EDF5" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid x:Name="DetailsContentGrid" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Source" />
                        <TextBlock x:Name="CompactSourceText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Margin="20,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Output" />
                        <TextBlock x:Name="CompactOutputText" Grid.Column="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock x:Name="DetailsPlaceholderText" Text="Select one item to view its record details." TextTrimming="CharacterEllipsis" />
                    <ScrollViewer x:Name="ExpandedDetails" Grid.Row="1" Height="160" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DetailsCompletedText" FontWeight="SemiBold" />
                            <TextBlock x:Name="DetailsStatusText" Margin="0,4,0,8" />
                            <TextBlock FontWeight="SemiBold" Text="Source" />
                            <TextBox x:Name="DetailsSourcePathTextBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" />
                            <TextBlock FontWeight="SemiBold" Text="Output" />
                            <TextBox x:Name="DetailsDestinationPathTextBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" />
                            <TextBlock x:Name="DetailsMetricsText" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Padding="28,11" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource InkMutedBrush}" Text="Loading history..." />
        </Border>
    </Grid>
</Window>
